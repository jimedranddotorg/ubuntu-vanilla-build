# -----------------------------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != "dumb" ]; then
    C_RESET=$'\033[0m'
    C_BOLD=$'\033[1m'
    C_DIM=$'\033[2m'
    C_RED=$'\033[31m'
    C_GREEN=$'\033[32m'
    C_YELLOW=$'\033[33m'
    if [[ "${TERM:-}" == *256color* || -n "${COLORTERM:-}" ]]; then
        C_ACCENT=$'\033[1;38;5;208m'
    else
        C_ACCENT=$'\033[1;33m'
    fi
else
    C_RESET=""; C_BOLD=""; C_DIM=""; C_RED=""
    C_GREEN=""; C_YELLOW=""; C_ACCENT=""
fi

SYM_INFO="i"
SYM_OK="+"
SYM_WARN="!"
SYM_ERR="x"
SYM_PTR=">"
RULE_CHAR="-"
BANNER_CHAR="="
if [ "${TERM:-}" != "dumb" ] && [[ "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" =~ [Uu][Tt][Ff]-?8 ]]; then
    SYM_INFO="•"
    SYM_OK="✓"
    SYM_WARN="!"
    SYM_ERR="✗"
    SYM_PTR="›"
    RULE_CHAR="─"
    BANNER_CHAR="═"
fi

term_cols() {
    local cols="${COLUMNS:-}"
    if [[ ! "$cols" =~ ^[0-9]+$ ]] && command -v tput >/dev/null 2>&1 && [ -t 1 ]; then
        cols="$(tput cols 2>/dev/null || true)"
    fi
    [[ "$cols" =~ ^[0-9]+$ ]] || cols=80
    echo "$cols"
}

term_lines() {
    local lines="${LINES:-}"
    if [[ ! "$lines" =~ ^[0-9]+$ ]] && command -v tput >/dev/null 2>&1 && [ -t 1 ]; then
        lines="$(tput lines 2>/dev/null || true)"
    fi
    [[ "$lines" =~ ^[0-9]+$ ]] || lines=24
    echo "$lines"
}

rule_width() {
    local w=$(( $(term_cols) - 2 ))
    (( w > 72 )) && w=72
    (( w < 44 )) && w=44
    echo "$w"
}

repeat_char() {
    local ch="$1" count="$2" out="" i
    for (( i=0; i<count; i++ )); do
        out+="$ch"
    done
    printf '%s\n' "$out"
}

