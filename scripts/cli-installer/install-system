current_backtitle() {
    if [ -n "$STEP_LABEL" ]; then
        printf 'Unofficial CLI Installer  |  %s' "$STEP_LABEL"
    else
        printf 'Unofficial CLI Installer'
    fi
}

info()  { printf '  %s%s%s  %s\n' "$C_ACCENT" "$SYM_INFO" "$C_RESET" "$*"; }
ok()    { printf '  %s%s%s  %s%s%s\n' "$C_GREEN$C_BOLD" "$SYM_OK" "$C_RESET" "$C_BOLD" "$*" "$C_RESET"; }
warn()  { printf '  %s%s%s  %s%s%s\n' "$C_YELLOW$C_BOLD" "$SYM_WARN" "$C_RESET" "$C_BOLD" "$*" "$C_RESET" >&2; }
err()   { printf '  %s%s%s  %s%s%s\n' "$C_RED$C_BOLD" "$SYM_ERR" "$C_RESET" "$C_BOLD" "$*" "$C_RESET" >&2; }
hr()    { printf '%s%s%s\n' "$C_DIM" "$(repeat_char "$RULE_CHAR" "$(rule_width)")" "$C_RESET"; }
step()  {
    printf '\n%s%s%s %s%s%s\n' "$C_ACCENT" "${RULE_CHAR}${RULE_CHAR}" "$C_RESET" "$C_BOLD" "$*" "$C_RESET"
}
banner() {
    local w
    w="$(rule_width)"
    printf '\n%s' "$C_ACCENT"
    repeat_char "$BANNER_CHAR" "$w"
    printf '%s%s  %s%s\n' "$C_RESET" "$C_BOLD" "$*" "$C_RESET"
    printf '%s' "$C_ACCENT"
    repeat_char "$BANNER_CHAR" "$w"
    printf '%s\n' "$C_RESET"
}

step_begin() {
    local num="$1" total="$2" title="$3" subtitle="${4:-}"
    STEP_LABEL="Step ${num} of ${total}: ${title}"
    if [ "$UI_MODE" != "tui" ]; then
        printf '\n%s[%d/%d]%s %s%s%s\n' "$C_ACCENT" "$num" "$total" "$C_RESET" "$C_BOLD" "$title" "$C_RESET"
        hr
        if [ -n "$subtitle" ]; then
            info "$subtitle"
        fi
    fi
}

step_done() {
    if [ "$UI_MODE" != "tui" ]; then
        ok "$*"
    fi
}

close_gauge() {
    if [ "${GAUGE_FD_OPEN:-0}" -eq 1 ]; then
        { exec 3>&-; } 2>/dev/null || true
        GAUGE_FD_OPEN=0
    fi
    if [ -n "${GAUGE_PID:-}" ]; then
        wait "$GAUGE_PID" 2>/dev/null || true
        GAUGE_PID=""
    fi
    if [ -n "${GAUGE_FIFO:-}" ] && [ -p "$GAUGE_FIFO" ]; then
        rm -f "$GAUGE_FIFO" 2>/dev/null || true
        GAUGE_FIFO=""
    fi
}

die() {
    trap - EXIT
    close_gauge
    if [ "${UI_MODE:-}" = "tui" ] && (have_whiptail || have_dialog); then
        local err_msg="$*"
        if [ -f "${INSTALL_LOG:-}" ] && [ -s "$INSTALL_LOG" ]; then
            local log_tail
            log_tail="$(tail -n 12 "$INSTALL_LOG" 2>/dev/null || true)"
            err_msg="${err_msg}\n\nLast log lines (${INSTALL_LOG}):\n${log_tail}"
        fi
        local err_h err_w
        read -r err_h err_w < <(tui_box_dims "$(tui_text_height "$err_msg" 14)" 76)
        if have_whiptail; then
            whiptail --backtitle "$(current_backtitle)" --title "Installation Error" --msgbox "$err_msg" "$err_h" "$err_w" || true
        else
            dialog --backtitle "$(current_backtitle)" --title "Installation Error" --msgbox "$err_msg" "$err_h" "$err_w" || true
        fi
    fi
    err "$*"
    cleanup_mounts
    exit 1
}

trap 'on_interrupt' INT TERM
trap 'cleanup_mounts' EXIT
on_interrupt() {
    trap - EXIT
    close_gauge
    err "Interrupted. Unmounting target and aborting."
    cleanup_mounts
    exit 130
}

cleanup_mounts() {
    close_gauge
    # Tear down in reverse order, ignore errors.
    local idx mp=""
    for (( idx=${#MOUNT_POINTS[@]}-1 ; idx>=0 ; idx-- )); do
        mp="${MOUNT_POINTS[$idx]}"
        [ -n "$mp" ] || continue
        if mountpoint -q "$mp" 2>/dev/null; then
            umount "$mp" 2>/dev/null || umount -l "$mp" 2>/dev/null || true
        fi
    done
    MOUNT_POINTS=()
    # Deactivate any swap we activated on the target.
    if [ "${SWAP_ACTIVATED:-0}" -eq 1 ] && [ -n "${SWAP_PART:-}" ]; then
        swapoff "$SWAP_PART" 2>/dev/null || true
    fi
    SWAP_ACTIVATED=0
    [ -d "$TARGET_ROOT" ] && rmdir "$TARGET_ROOT" 2>/dev/null || true
    if [ -n "${DIALOGRC_FILE:-}" ] && [ -f "$DIALOGRC_FILE" ]; then
        rm -f "$DIALOGRC_FILE" 2>/dev/null || true
        DIALOGRC_FILE=""
    fi
}

# -----------------------------------------------------------------------------
# Prompt helpers (text mode)
# -----------------------------------------------------------------------------
text_input() {
    # text_input <prompt> [<default>]
    local prompt="$1" default="${2:-}" value=""
    if [ -n "$default" ]; then
        printf '  %s%s%s [%s]: ' "$C_BOLD" "$prompt" "$C_RESET" "$default"
    else
        printf '  %s%s%s: ' "$C_BOLD" "$prompt" "$C_RESET"
    fi
    IFS= read -r value || die "Cancelled by user."
    if [ -z "$value" ] && [ -n "$default" ]; then
        REPLY="$default"
    else
        REPLY="$value"
    fi
}

text_password() {
    # text_password <prompt> — sets REPLY
    local prompt="$1" value=""
    printf '  %s%s%s: ' "$C_BOLD" "$prompt" "$C_RESET"
    IFS= read -rs value || die "Cancelled by user."
    printf '\n'
    REPLY="$value"
}

text_yesno() {
    # text_yesno <prompt> [<default y|n>] — sets REPLY to y or n
    local prompt="$1" default="${2:-}" ans="" suffix=""
    if [ "$default" = "y" ]; then suffix=" [Y/n]"
    elif [ "$default" = "n" ]; then suffix=" [y/N]"
    else suffix=" [y/n]"; fi
    while :; do
        printf '  %s%s%s%s: ' "$C_BOLD" "$prompt" "$C_RESET" "$suffix"
        IFS= read -r ans || die "Cancelled by user."
        ans="${ans:-$default}"
        case "$ans" in
            y|Y|yes|YES) REPLY="y"; return 0 ;;
            n|N|no|NO)   REPLY="n"; return 0 ;;
            *) warn "Please answer 'y' or 'n'." ;;
        esac
    done
}

text_choice() {
    # text_choice <prompt> <default_index(1-based)> <choice>... — sets REPLY
    local prompt="$1" default="$2"; shift 2
    local i=1 choice
    printf '\n  %s%s%s\n' "$C_BOLD" "$prompt" "$C_RESET"
    for choice in "$@"; do
        if [ "$i" -eq "$default" ]; then
            printf '  %s%s%s %2d) %s %s[default]%s\n' "$C_GREEN$C_BOLD" "$SYM_PTR" "$C_RESET" "$i" "$choice" "$C_GREEN" "$C_RESET"
        else
            printf '    %2d) %s\n' "$i" "$choice"
        fi
        i=$((i+1))
    done
    local ans
    while :; do
        printf '  Select [1-%d, Enter=%d]: ' "$(($#))" "$default"
        IFS= read -r ans || die "Cancelled by user."
        ans="${ans:-$default}"
        if [[ "$ans" =~ ^[0-9]+$ ]] && [ "$ans" -ge 1 ] && [ "$ans" -le $# ]; then
            REPLY="${!ans}"
            return 0
        fi
        warn "Invalid choice '$ans' — enter 1-$#."
    done
}

print_columns() {
    # print_columns <default_idx_1based> <col_width> <label1> [<label2>...]
    local def_idx="$1" col_w="$2"
    shift 2
    local -a items=("$@")
    local count="${#items[@]}"
    local tcols ncols rows r c idx text
    tcols="$(term_cols)"
    ncols=$(( (tcols - 2) / col_w ))
    (( ncols < 1 )) && ncols=1
    (( ncols > 3 )) && ncols=3
    rows=$(( (count + ncols - 1) / ncols ))

    for (( r=0; r<rows; r++ )); do
        printf '  '
        for (( c=0; c<ncols; c++ )); do
            idx=$(( c * rows + r ))
            if (( idx < count )); then
                text="${items[$idx]}"
                if (( idx + 1 == def_idx )); then
                    printf '%s%s %3d) %-*s%s' "$C_GREEN$C_BOLD" "$SYM_PTR" "$((idx + 1))" "$((col_w - 8))" "$text" "$C_RESET"
                else
                    printf '  %3d) %-*s' "$((idx + 1))" "$((col_w - 8))" "$text"
                fi
            fi
        done
        printf '\n'
    done
}

# -----------------------------------------------------------------------------
# Architecture & Distro Detection
# -----------------------------------------------------------------------------
target_arch() {
    if [ -x "$TARGET_ROOT/usr/bin/dpkg" ]; then
        chroot "$TARGET_ROOT" dpkg --print-architecture 2>/dev/null && return 0
    fi
    case "$(uname -m)" in
        x86_64|amd64)  echo "amd64" ;;
        aarch64|arm64) echo "arm64" ;;
        *)             uname -m ;;
    esac
}

host_arch() {
    case "$(uname -m)" in
        x86_64|amd64)  echo "amd64" ;;
        aarch64|arm64) echo "arm64" ;;
        *)             uname -m ;;
    esac
}

target_bootloader_id() {
    if [ -r "$TARGET_ROOT/etc/os-release" ] && grep -qs '^ID=pop$' "$TARGET_ROOT/etc/os-release"; then
        echo "pop"
    else
        echo "ubuntu"
    fi
}

# -----------------------------------------------------------------------------
# Prompt helpers (TUI mode — whiptail, fall back to dialog)
# -----------------------------------------------------------------------------
have_whiptail() { command -v whiptail >/dev/null 2>&1; }
have_dialog()  { command -v dialog  >/dev/null 2>&1; }

tui_box_dims() {
    local desired_h="$1" desired_w="$2"
    local rows cols max_h max_w h w
    rows="$(term_lines)"
    cols="$(term_cols)"
    max_h=$(( rows - 4 ))
    max_w=$(( cols - 4 ))
    (( max_h < 10 )) && max_h=10
    (( max_w < 48 )) && max_w=48
    h="$desired_h"
    w="$desired_w"
    (( h > max_h )) && h="$max_h"
    (( w > max_w )) && w="$max_w"
    printf '%d %d\n' "$h" "$w"
}

tui_text_height() {
    local msg="$1" min_h="${2:-10}"
    local expanded lines h
    expanded="$(printf '%b' "$msg")"
    lines="$(printf '%s\n' "$expanded" | wc -l)"
    h=$(( lines + 7 ))
    (( h < min_h )) && h="$min_h"
    printf '%d\n' "$h"
}

tui_msg() {
    # tui_msg <title> <message>
    local title="$1" msg="$2" rc=0 h w desired_h
    desired_h="$(tui_text_height "$msg" 12)"
    read -r h w < <(tui_box_dims "$desired_h" 76)
    if have_whiptail; then
        whiptail --backtitle "$(current_backtitle)" --title "$title" --msgbox "$msg" "$h" "$w" || rc=$?
    else
        dialog --backtitle "$(current_backtitle)" --title "$title" --msgbox "$msg" "$h" "$w" || rc=$?
    fi
    [ "$rc" -eq 0 ] || die "Cancelled by user."
}

tui_yesno() {
    # tui_yesno <title> <text> [<default y|n|0|1>] — sets REPLY to y or n
    local title="$1" text="$2" default="${3:-y}"
    local rc=0 h w desired_h
    local -a extra=()
    if [ "$default" = "n" ] || [ "$default" = "1" ]; then
        extra+=(--defaultno)
    fi
    desired_h="$(tui_text_height "$text" 10)"
    read -r h w < <(tui_box_dims "$desired_h" 76)
    if have_whiptail; then
        whiptail --backtitle "$(current_backtitle)" --title "$title" "${extra[@]}" --yesno "$text" "$h" "$w" || rc=$?
    else
        dialog --backtitle "$(current_backtitle)" --title "$title" "${extra[@]}" --yesno "$text" "$h" "$w" || rc=$?
    fi
    if [ "$rc" -eq 255 ]; then
        die "Cancelled by user."
    elif [ "$rc" -eq 0 ]; then
        REPLY="y"
    else
        REPLY="n"
    fi
}

tui_input() {
    # tui_input <title> <text> <default> — sets REPLY
    local title="$1" text="$2" default="${3:-}" rc=0 h w desired_h
    desired_h="$(tui_text_height "$text" 10)"
    read -r h w < <(tui_box_dims "$desired_h" 74)
    if have_whiptail; then
        REPLY="$(whiptail --backtitle "$(current_backtitle)" --title "$title" --inputbox "$text" "$h" "$w" "$default" 3>&1 1>&2 2>&3)" || rc=$?
    else
        REPLY="$(dialog --backtitle "$(current_backtitle)" --title "$title" --inputbox "$text" "$h" "$w" "$default" 3>&1 1>&2 2>&3)" || rc=$?
    fi
    [ "$rc" -eq 0 ] || die "Cancelled by user."
    if [ -z "$REPLY" ]; then
        REPLY="$default"
    fi
}

tui_password() {
    # tui_password <title> <text> — sets REPLY
    local title="$1" text="$2" rc=0 h w desired_h
    desired_h="$(tui_text_height "$text" 10)"
    read -r h w < <(tui_box_dims "$desired_h" 74)
    if have_whiptail; then
        REPLY="$(whiptail --backtitle "$(current_backtitle)" --title "$title" --passwordbox "$text" "$h" "$w" 3>&1 1>&2 2>&3)" || rc=$?
    else
        REPLY="$(dialog --backtitle "$(current_backtitle)" --title "$title" --passwordbox "$text" "$h" "$w" 3>&1 1>&2 2>&3)" || rc=$?
    fi
    [ "$rc" -eq 0 ] || die "Cancelled by user."
}

tui_menu() {
    # tui_menu <title> <text> <default_tag> <choice_tag> <choice_text>...
    local title="$1" text="$2" default="$3"; shift 3
    local rc=0 count max_h w max_list list_h h
    count=$(( $# / 2 ))
    read -r max_h w < <(tui_box_dims 22 76)
    max_list=$(( max_h - 8 ))
    (( max_list < 4 )) && max_list=4
    list_h=$(( count > max_list ? max_list : count ))
    h=$(( list_h + 8 ))
    (( h > max_h )) && h="$max_h"
    local -a cmd_prefix=()
    [ -n "$default" ] && cmd_prefix=(--default-item "$default")
    if have_whiptail; then
        REPLY="$(whiptail --backtitle "$(current_backtitle)" --title "$title" "${cmd_prefix[@]}" --menu "$text" "$h" "$w" "$list_h" "$@" 3>&1 1>&2 2>&3)" || rc=$?
    else
        REPLY="$(dialog --backtitle "$(current_backtitle)" --title "$title" "${cmd_prefix[@]}" --menu "$text" "$h" "$w" "$list_h" "$@" 3>&1 1>&2 2>&3)" || rc=$?
    fi
    [ "$rc" -eq 0 ] || die "Cancelled by user."
}

open_gauge() {
    local title="$1" init_msg="$2" h w
    read -r h w < <(tui_box_dims 9 74)
    GAUGE_FIFO="$(mktemp -u "${TMPDIR:-/tmp}/install-system-gauge.XXXXXX")"
    mkfifo "$GAUGE_FIFO"
    if have_whiptail; then
        whiptail --backtitle "$(current_backtitle)" --title "$title" --gauge "$init_msg" "$h" "$w" 0 < "$GAUGE_FIFO" &
    else
        dialog --backtitle "$(current_backtitle)" --title "$title" --gauge "$init_msg" "$h" "$w" 0 < "$GAUGE_FIFO" &
    fi
    GAUGE_PID=$!
    exec 3> "$GAUGE_FIFO"
    GAUGE_FD_OPEN=1
}

progress_update() {
    local pct="$1" msg="$2"
    if [ "$UI_MODE" = "tui" ] && [ "${GAUGE_FD_OPEN:-0}" -eq 1 ]; then
        if [ -n "${GAUGE_PID:-}" ] && kill -0 "$GAUGE_PID" 2>/dev/null; then
            printf 'XXX\n%d\n%s\nXXX\n' "$pct" "$msg" >&3 2>/dev/null || true
        fi
    elif [ "$UI_MODE" != "tui" ]; then
        printf '%s[%3d%%]%s %s\n' "$C_ACCENT" "$pct" "$C_RESET" "$msg"
    fi
}

# -----------------------------------------------------------------------------
# Mode-aware wrappers
# -----------------------------------------------------------------------------
ui_msg() {
    if [ "$UI_MODE" = "tui" ]; then
        tui_msg "$@"
    else
        local t="$1"; shift
        printf '%s%s%s\n\n' "$C_BOLD" "$t" "$C_RESET"
        printf '%s\n' "$*"
        printf 'Press Enter to continue... '
        IFS= read -r _ || die "Cancelled by user."
    fi
}
ui_warn() {
    if [ "$UI_MODE" = "tui" ]; then
        local title="$1" msg="$2" h w
        read -r h w < <(tui_box_dims "$(tui_text_height "$msg" 10)" 74)
        if have_whiptail; then
            whiptail --backtitle "$(current_backtitle)" --title "$title" --msgbox "$msg" "$h" "$w" || true
        else
            dialog --backtitle "$(current_backtitle)" --title "$title" --msgbox "$msg" "$h" "$w" || true
        fi
    else
        shift
        warn "$*"
    fi
}
ui_yesno()    { if [ "$UI_MODE" = "tui" ]; then tui_yesno  "$@"; else local t="$1" m="$2" d="${3:-}"; text_yesno "$m" "$d"; fi }
ui_input()    { if [ "$UI_MODE" = "tui" ]; then tui_input  "$@"; else local t="$1" m="$2" d="${3:-}"; text_input "$m" "$d"; fi }
ui_password() { if [ "$UI_MODE" = "tui" ]; then tui_password "$@"; else local t="$1" m="$2"; text_password "$m"; fi }

# -----------------------------------------------------------------------------
# Pre-flight
# -----------------------------------------------------------------------------
require_root() {
    if [ "$(id -u)" -ne 0 ]; then
        die "This installer must be run as root (try: sudo $SCRIPT_NAME)."
    fi
}

is_live_session() {
    if grep -qw 'boot=casper' /proc/cmdline 2>/dev/null; then
        return 0
    fi
    local root_fstype=""
    root_fstype="$(findmnt -n -o FSTYPE / 2>/dev/null || stat -f -c %T / 2>/dev/null || true)"
    case "$root_fstype" in
        overlay|overlayfs|aufs|tmpfs|squashfs) return 0 ;;
    esac
    return 1
}

check_live_env() {
    detect_live_distro
    if ! is_live_session; then
        die "This system appears to be an installed system, not a live ISO session.
The installer only runs from the live ISO environment."
    fi
    if [ ! -f "$LIVE_SQUASHFS" ]; then
        die "Live squashfs not found at $LIVE_SQUASHFS.
This installer must be run from a ${DISTRO_NAME} live ISO.
If you booted a minimal/server ISO, use debootstrap instead."
    fi
    if ! [ -d "$LIVE_CDROM" ]; then
        die "Live CD mountpoint $LIVE_CDROM not found. Are you running on the live ISO?"
    fi
}

