describe_timezone() {
    local tz="$1"
    if [ "$tz" = "UTC" ]; then
        echo "Coordinated Universal Time"
    elif [[ "$tz" == */*/* ]]; then
        local reg="${tz%%/*}" rest="${tz#*/}"
        rest="${rest//\// - }"
        echo "${reg} — ${rest//_/ }"
    elif [[ "$tz" == */* ]]; then
        local reg="${tz%%/*}" city="${tz#*/}"
        echo "${reg} — ${city//_/ }"
    else
        echo "$tz"
    fi
}

step_timezone() {
    step_begin 4 7 "Timezone"

    # Try NTP sync silently in TUI mode (to avoid stdout flicker), visibly in CLI mode.
    if [ "$USE_NTP" -eq 1 ] && command -v timedatectl >/dev/null 2>&1; then
        [ "$UI_MODE" != "tui" ] && info "Checking network connectivity for NTP sync..."
        if timeout 3 getent ahosts 2.pool.ntp.org >/dev/null 2>&1; then
            timedatectl set-ntp true >/dev/null 2>&1 || true
            sleep 1
            local ntp_status=""
            ntp_status="$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)"
            if [ "$UI_MODE" != "tui" ]; then
                if [ "$ntp_status" = "yes" ]; then
                    ok "System clock synchronized with NTP."
                else
                    info "Using live session clock (NTP pending)."
                fi
            fi
        elif [ "$UI_MODE" != "tui" ]; then
            info "Offline — using live session clock."
        fi
    fi

    local current_tz="" guess_default="America/New_York"
    if [ -f /etc/timezone ]; then
        current_tz="$(tr -d '[:space:]' < /etc/timezone 2>/dev/null || true)"
    fi
    if [ -z "$current_tz" ] && command -v timedatectl >/dev/null 2>&1; then
        current_tz="$(timedatectl show -p Timezone --value 2>/dev/null | tr -d '[:space:]' || true)"
    fi
    if [ -z "$current_tz" ] && [ -L /etc/localtime ]; then
        local lt=""
        lt="$(readlink -f /etc/localtime 2>/dev/null || true)"
        if [[ "$lt" == /usr/share/zoneinfo/* ]]; then
            current_tz="${lt#/usr/share/zoneinfo/}"
        fi
    fi
    [ "$current_tz" = "Etc/UTC" ] && current_tz="UTC"
    if [ -n "$current_tz" ] && [ -e "/usr/share/zoneinfo/$current_tz" ]; then
        guess_default="$current_tz"
    fi

    if [ "$UI_MODE" = "tui" ]; then
        local args=() tz found_default=0
        while IFS= read -r tz; do
            [ -z "$tz" ] && continue
            [ "$tz" = "$guess_default" ] && found_default=1
            args+=("$tz" "$(describe_timezone "$tz")")
        done < <(read_timezones)
        if [ "$found_default" -eq 0 ]; then
            args=("$guess_default" "$(describe_timezone "$guess_default")" "${args[@]}")
        fi
        args+=("__custom__" "Custom (type any IANA timezone)")
        tui_menu "Timezone" "Select your timezone:" "$guess_default" "${args[@]}"
        if [ "$REPLY" = "__custom__" ]; then
            tui_input "Custom Timezone" "Enter an IANA timezone (e.g. Asia/Jakarta):" "$guess_default"
            TIMEZONE="$REPLY"
        else
            TIMEZONE="$REPLY"
        fi
    else
        local lines=() tz found_default=0 default_idx=1
        while IFS= read -r tz; do
            [ -z "$tz" ] && continue
            [ "$tz" = "$guess_default" ] && found_default=1
            lines+=("$tz")
        done < <(read_timezones)
        if [ "$found_default" -eq 0 ]; then
            lines=("$guess_default" "${lines[@]}")
        fi
        local i=1
        for tz in "${lines[@]}"; do
            [ "$tz" = "$guess_default" ] && default_idx="$i"
            i=$((i + 1))
        done
        lines+=("__custom__")
        printf '\n'
        print_columns "$default_idx" 38 "${lines[@]/__custom__/Custom IANA timezone...}"
        printf '\n'
        local custom_idx="${#lines[@]}"
        text_input "Choose number or type IANA timezone" "$default_idx"
        if [ "$REPLY" = "$custom_idx" ]; then
            text_input "Enter IANA timezone" "$guess_default"
            TIMEZONE="$REPLY"
        elif [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -lt "$custom_idx" ]; then
            TIMEZONE="${lines[$((REPLY-1))]}"
        elif [ -n "$REPLY" ] && [ -e "/usr/share/zoneinfo/$REPLY" ]; then
            TIMEZONE="$REPLY"
        else
            text_input "Enter IANA timezone" "$guess_default"
            TIMEZONE="$REPLY"
        fi
    fi

    if [ -z "$TIMEZONE" ] || [ ! -e "/usr/share/zoneinfo/$TIMEZONE" ]; then
        if [ "$UI_MODE" = "tui" ]; then
            ui_warn "Unknown Timezone" "Unknown timezone '${TIMEZONE}' — falling back to UTC."
        else
            warn "Unknown timezone '$TIMEZONE' — falling back to UTC."
        fi
        TIMEZONE="UTC"
    fi
    step_done "Timezone: $TIMEZONE"
}

# -----------------------------------------------------------------------------
# STEP: disk target
# -----------------------------------------------------------------------------
list_block_devices() {
    # Echo "<dev>\t<size>\t<model>" lines, skipping loop/ram/zram/dm-.*.
    lsblk -bdno NAME,SIZE,TYPE,MODEL 2>/dev/null | awk '
        $3 == "disk" && $1 !~ /^(loop|ram|zram|dm-|fd|sr)/ && $1 !~ /^mmcblk[0-9]+(boot[0-9]+|rpmb)$/ {
            model = ""
            for (i = 4; i <= NF; i++) {
                model = (model == "" ? $i : model " " $i)
            }
            if (model == "") model = "Disk"
            printf "/dev/%s\t%s\t%s\n", $1, $2, model
        }
    '
}

step_disk() {
    step_begin 5 7 "Installation Type & Disk" "Choose automatic fixed partitioning or manual partition assignment."

    if [ "$UI_MODE" = "tui" ]; then
        tui_menu "Installation Type" \
            "How would you like to prepare your disk for ${DISTRO_NAME}?" \
            "erase" \
            "erase"  "Erase disk (GPT: BIOS boot + 512 MiB EFI + 4 GiB swap + root)" \
            "manual" "Manual partitioning (cfdisk + assign /, /boot/efi, swap)"
        DISK_MODE="$REPLY"
    else
        text_choice "Choose installation type:" 1 \
            "Erase disk and install ${DISTRO_NAME} (fixed GPT layout)" \
            "Manual partitioning (cfdisk + assign /, /boot/efi, and swap)"
        case "$REPLY" in
            Erase*) DISK_MODE="erase" ;;
            *)      DISK_MODE="manual" ;;
        esac
    fi

    # List candidate disks
    local devmap
    devmap="$(mktemp)"
    list_block_devices > "$devmap"
    if [ ! -s "$devmap" ]; then
        rm -f "$devmap"
        die "No candidate block devices found."
    fi

    if [ "$UI_MODE" = "tui" ]; then
        local args=() dev size model
        while IFS=$'\t' read -r dev size model; do
            [ -z "$dev" ] && continue
            local human
            human="$(numfmt --to=iec --suffix=B "$size" 2>/dev/null || echo "$size")"
            args+=("$dev" "$human — $model")
        done < "$devmap"
        tui_menu "Target Disk" "Select the disk to install ${DISTRO_NAME} onto:" "${args[0]}" "${args[@]}"
        DISK_TARGET="$REPLY"
    else
        printf '\n'
        info "Available disks:"
        local lines=() dev size model
        while IFS=$'\t' read -r dev size model; do
            [ -z "$dev" ] && continue
            lines+=("$dev")
            local human
            human="$(numfmt --to=iec --suffix=B "$size" 2>/dev/null || echo "$size")"
            printf '    %2d) %-14s (%s — %s)\n' "${#lines[@]}" "$dev" "$human" "$model"
        done < "$devmap"
        text_input "Choose a disk by number" "1"
        if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le "${#lines[@]}" ]; then
            DISK_TARGET="${lines[$((REPLY-1))]}"
        else
            rm -f "$devmap"
            die "Invalid disk selection."
        fi
    fi
    rm -f "$devmap"

    if [ "$DISK_MODE" = "erase" ]; then
        choose_root_filesystem 0 ""
        FORMAT_ROOT=1
        FORMAT_EFI=1
        FORMAT_SWAP=1
        EFI_PART=""
        ROOT_PART=""
        SWAP_PART=""
        if [ "$UI_MODE" = "tui" ]; then
            tui_yesno "Confirm Erase Disk" "ALL DATA on ${DISK_TARGET} will be erased when installation begins.\n\nFixed GPT layout:\n  - 1 MiB BIOS boot (amd64)\n  - 512 MiB EFI System Partition (/boot/efi)\n  - 4 GiB swap\n  - Remainder ${ROOT_FSTYPE} root (/)\n\nUse ${DISK_TARGET}?" "n"
        else
            printf '\n'
            warn "ALL DATA on $DISK_TARGET will be erased when installation begins."
            info "Layout: 512 MiB EFI (/boot/efi) + 4 GiB swap + ${ROOT_FSTYPE} root (/)"
            text_yesno "Erase and install onto $DISK_TARGET?" "n"
        fi
        [ "$REPLY" = "y" ] || die "Aborted by user before partitioning."
    else
        configure_manual_partitions "$DISK_TARGET"
    fi
    step_done "Target disk: $DISK_TARGET ($DISK_MODE mode)"
}

# -----------------------------------------------------------------------------
# STEP: user account ("Who are you?")
# -----------------------------------------------------------------------------
validate_username() {
    local u="$1"
    [[ "$u" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || return 1
    case "$u" in
        root|daemon|bin|sys|sync|games|man|lp|mail|news|uucp|proxy|www-data|backup|list|irc|nobody|_apt|systemd-*|messagebus|sshd) return 1 ;;
    esac
    return 0
}

step_user() {
    step_begin 6 7 "User Account & Hostname"

    ui_input "Your Name" "Enter your full name (optional, leave empty to skip)" ""
    FULLNAME="$REPLY"

    local def_host="ubuntu"
    [ "$DISTRO_ID" = "pop" ] && def_host="pop-os"
    while :; do
        ui_input "Computer Name" "Enter a hostname for this computer" "$def_host"
        HOSTNAME="$REPLY"
        [[ "$HOSTNAME" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]] || { ui_warn "Invalid Hostname" "Invalid hostname '$HOSTNAME'. Use letters, digits, and hyphens."; continue; }
        break
    done

    while :; do
        ui_input "Username" "Enter a username (lowercase, starts with a letter)" "user"
        USERNAME="$REPLY"
        if validate_username "$USERNAME"; then break; fi
        ui_warn "Invalid Username" "Invalid username '$USERNAME'. Use lowercase letters, digits, '_' or '-', max 32 chars."
    done

    while :; do
        ui_password "Choose Password" "Enter a password for ${USERNAME} (min 8 chars)"
        PASSWORD="$REPLY"
        if [ "${#PASSWORD}" -lt 8 ]; then
            ui_warn "Weak Password" "Password must be at least 8 characters. Try again."
            continue
        fi
        ui_password "Confirm Password" "Re-enter the password for ${USERNAME}"
        if [ "$REPLY" = "$PASSWORD" ]; then break; fi
        ui_warn "Password Mismatch" "Passwords do not match. Try again."
    done

    step_done "User: ${FULLNAME:-$USERNAME} ($USERNAME) on $HOSTNAME"
}

# -----------------------------------------------------------------------------
# STEP: summary
# -----------------------------------------------------------------------------
step_summary() {
    step_begin 7 7 "Ready to Install"
    local disk_plan=""
    if [ "$DISK_MODE" = "erase" ]; then
        disk_plan="$(cat <<EOF
    Mode        : Fixed GPT (ERASE entire disk ${DISK_TARGET})
    Layout      : 512 MiB FAT32 (/boot/efi) + 4 GiB swap + ${ROOT_FSTYPE} (/)
EOF
)"
    else
        local root_act="keep existing" efi_act="none" swap_act="none"
        [ "$FORMAT_ROOT" -eq 1 ] && root_act="format as ${ROOT_FSTYPE}"
        if [ -n "$EFI_PART" ]; then
            efi_act="${EFI_PART} ($([ "$FORMAT_EFI" -eq 1 ] && echo 'format FAT32' || echo 'keep FAT32'))"
        fi
        if [ -n "$SWAP_PART" ]; then
            swap_act="${SWAP_PART} ($([ "$FORMAT_SWAP" -eq 1 ] && echo 'initialize swap' || echo 'reuse swap'))"
        fi
        disk_plan="$(cat <<EOF
    Mode        : Manual partitioning (${DISK_TARGET})
    Root (/)    : ${ROOT_PART} (${root_act})
    EFI         : ${efi_act}
    Swap        : ${swap_act}
EOF
)"
    fi

    local summary
    summary="$(cat <<EOF
  Distribution : ${DISTRO_NAME}
  Language     : ${LOCALE}
  Keyboard     : ${KEYBOARD_LAYOUT}${KEYBOARD_VARIANT:+ (${KEYBOARD_VARIANT})}
  Timezone     : ${TIMEZONE}

  Storage:
${disk_plan}

  Account:
    Full name  : ${FULLNAME:-"(none)"}
    Username   : ${USERNAME}
    Hostname   : ${HOSTNAME}
EOF
)"
    if [ "$UI_MODE" = "tui" ]; then
        tui_yesno "Ready to Install ${DISTRO_NAME}" "${summary}\n\nNothing has been written to disk yet.\nBegin installing ${DISTRO_NAME} onto ${DISK_TARGET} now?" "n"
    else
        printf '\n%s\n\n' "$summary"
        text_yesno "Begin installing ${DISTRO_NAME} onto ${DISK_TARGET} now?" "n"
    fi
    [ "$REPLY" = "y" ] || die "Aborted by user at the summary step."
}

# -----------------------------------------------------------------------------
# PARTITIONING (Calmares 'partition' module equivalent)
# -----------------------------------------------------------------------------
deactivate_disk_holders() {
    local dev="$1"
    local p mnt=""
    while IFS= read -r p; do
        [ -n "$p" ] || continue
        mnt="$(findmnt -rn -S "$p" -o TARGET 2>/dev/null || true)"
        if [ -n "$mnt" ]; then
            if [ "$mnt" = "$LIVE_CDROM" ] || [[ "$mnt" == /cdrom* ]]; then
                die "Target disk $dev holds the live ISO mount ($mnt); choose a different disk."
            fi
        fi
        swapoff "$p" 2>/dev/null || true
    done < <(lsblk -lnpo NAME "$dev" 2>/dev/null || true)
}

partition_erase() {
    local dev="$1"
    local arch
    arch="$(host_arch)"

    deactivate_disk_holders "$dev"
    wipefs -af "$dev" >/dev/null 2>&1 || true
    sgdisk --zap-all "$dev" >/dev/null

    if [ "$arch" = "arm64" ]; then
        info "Wiping $dev and creating GPT layout (512 MiB ESP + 4 GiB swap + root)."
        sgdisk -n1:0:+512M -t1:EF00 -c1:"EFI System" "$dev" >/dev/null
        sgdisk -n2:0:+4G   -t2:8200 -c2:"swap"        "$dev" >/dev/null
        sgdisk -n3:0:0     -t3:8300 -c3:"root"        "$dev" >/dev/null
        partprobe "$dev" >/dev/null 2>&1 || true
        sleep 1
        udevadm settle >/dev/null 2>&1 || true
        if [[ "$dev" =~ [0-9]$ ]]; then
            EFI_PART="${dev}p1"; SWAP_PART="${dev}p2"; ROOT_PART="${dev}p3"
        else
            EFI_PART="${dev}1";  SWAP_PART="${dev}2";  ROOT_PART="${dev}3"
        fi
    else
        info "Wiping $dev and creating hybrid GPT layout (1 MiB BIOS boot + 512 MiB ESP + 4 GiB swap + root)."
        sgdisk -n1:0:+1M   -t1:EF02 -c1:"BIOS boot"  "$dev" >/dev/null
        sgdisk -n2:0:+512M -t2:EF00 -c2:"EFI System" "$dev" >/dev/null
        sgdisk -n3:0:+4G   -t3:8200 -c3:"swap"        "$dev" >/dev/null
        sgdisk -n4:0:0     -t4:8300 -c4:"root"        "$dev" >/dev/null
        partprobe "$dev" >/dev/null 2>&1 || true
        sleep 1
        udevadm settle >/dev/null 2>&1 || true
        if [[ "$dev" =~ [0-9]$ ]]; then
            EFI_PART="${dev}p2"; SWAP_PART="${dev}p3"; ROOT_PART="${dev}p4"
        else
            EFI_PART="${dev}2";  SWAP_PART="${dev}3";  ROOT_PART="${dev}4"
        fi
    fi

    [ -b "$EFI_PART" ]  || die "EFI partition $EFI_PART not found after partitioning."
    [ -b "$SWAP_PART" ] || die "Swap partition $SWAP_PART not found after partitioning."
    [ -b "$ROOT_PART" ] || die "Root partition $ROOT_PART not found after partitioning."

    info "Formatting EFI ($EFI_PART) as FAT32..."
    mkfs.fat -F32 -n EFI "$EFI_PART" >/dev/null
    info "Formatting swap ($SWAP_PART)..."
    mkswap -L swap "$SWAP_PART" >/dev/null
    format_root_partition "$ROOT_PART" "$ROOT_FSTYPE"
}

available_root_filesystems() {
    local fs
    for fs in ext4 btrfs xfs ext3 ext2 f2fs jfs; do
        if command -v "mkfs.${fs}" >/dev/null 2>&1; then
            printf '%s\n' "$fs"
        fi
    done
}

describe_root_filesystem() {
    case "$1" in
        ext4)  echo "Standard Linux journaling filesystem (recommended)" ;;
        btrfs) echo "Copy-on-write filesystem with snapshots" ;;
        xfs)   echo "High-performance 64-bit journaling filesystem" ;;
        ext3)  echo "Legacy journaling ext filesystem" ;;
        ext2)  echo "Legacy non-journaling ext filesystem" ;;
        f2fs)  echo "Flash-Friendly File System (SSD/NVMe/flash)" ;;
        jfs)   echo "IBM Journaled File System" ;;
        *)     echo "$1 filesystem" ;;
    esac
}

choose_root_filesystem() {
    # choose_root_filesystem <allow_keep 0|1> [<existing_fs>]
    # Sets FORMAT_ROOT and ROOT_FSTYPE.
    local allow_keep="$1" existing_fs="${2:-}"
    local -a fs_list=()
    mapfile -t fs_list < <(available_root_filesystems)
    [ "${#fs_list[@]}" -ge 1 ] || die "No supported mkfs.* root filesystem tools found."

    local prompt="Choose filesystem to format root (/):"
    if [ "$allow_keep" -eq 1 ] && [ -n "$existing_fs" ]; then
        prompt="Selected root partition already has '${existing_fs}'.\nChoose a filesystem to format it, or keep existing:"
    fi

    if [ "$UI_MODE" = "tui" ]; then
        local args=() fs
        for fs in "${fs_list[@]}"; do
            args+=("format_${fs}" "$(printf '%-5s — %s' "$fs" "$(describe_root_filesystem "$fs")")")
        done
        if [ "$allow_keep" -eq 1 ] && [ -n "$existing_fs" ]; then
            args+=("keep" "Keep existing ${existing_fs} filesystem without formatting")
        fi
        tui_menu "Root (/) Filesystem" "$prompt" "format_${fs_list[0]}" "${args[@]}"
    else
        local tags=() choices=() fs
        for fs in "${fs_list[@]}"; do
            tags+=("format_${fs}")
            choices+=("$(printf '%-5s — %s' "$fs" "$(describe_root_filesystem "$fs")")")
        done
        if [ "$allow_keep" -eq 1 ] && [ -n "$existing_fs" ]; then
            tags+=("keep")
            choices+=("keep — Keep existing ${existing_fs} without formatting")
        fi
        text_choice "Choose root (/) filesystem:" 1 "${choices[@]}"
        local idx=0
        for (( idx=0; idx<${#choices[@]}; idx++ )); do
            if [ "${choices[$idx]}" = "$REPLY" ]; then
                REPLY="${tags[$idx]}"
                break
            fi
        done
    fi

    if [ "$REPLY" = "keep" ] && [ -n "$existing_fs" ]; then
        FORMAT_ROOT=0
        ROOT_FSTYPE="$existing_fs"
    else
        FORMAT_ROOT=1
        ROOT_FSTYPE="${REPLY#format_}"
    fi
}

format_root_partition() {
    local part="$1" fstype="$2"
    info "Formatting root ($part) as $fstype..."
    case "$fstype" in
        ext4|ext3|ext2) "mkfs.${fstype}" -F -L root "$part" >/dev/null ;;
        btrfs)          mkfs.btrfs -f -L root "$part" >/dev/null ;;
        xfs)            mkfs.xfs -f -L root "$part" >/dev/null ;;
        f2fs)           mkfs.f2fs -f -l root "$part" >/dev/null ;;
        jfs)            mkfs.jfs -q -L root "$part" >/dev/null ;;
        *)              die "Unsupported root filesystem: $fstype" ;;
    esac
}

describe_partition() {
    local part="$1"
    local psize="" pfs="" plabel=""
    psize="$(lsblk -dno SIZE "$part" 2>/dev/null | tr -d '[:space:]' || true)"
    pfs="$(blkid -s TYPE -o value "$part" 2>/dev/null || true)"
    plabel="$(blkid -s LABEL -o value "$part" 2>/dev/null || true)"
    printf '%s — %s%s' "${psize:-?}" "${pfs:-unformatted}" "${plabel:+ [$plabel]}"
}

pick_partition_menu() {
    # pick_partition_menu <title> <prompt> <default_tag> <include_none> <none_desc> <part>...
    local title="$1" prompt="$2" default_tag="$3" include_none="$4" none_desc="$5"
    shift 5
    local -a cands=("$@")
    if [ "$UI_MODE" = "tui" ]; then
        local args=() p
        for p in "${cands[@]}"; do
            args+=("$p" "$(describe_partition "$p")")
        done
        if [ "$include_none" -eq 1 ]; then
            args+=("__none__" "$none_desc")
        fi
        [ -n "$default_tag" ] || default_tag="${args[0]}"
        tui_menu "$title" "$prompt" "$default_tag" "${args[@]}"
    else
        local tags=() descs=() p idx=1 def_idx=1
        for p in "${cands[@]}"; do
            tags+=("$p")
            descs+=("$(describe_partition "$p")")
        done
        if [ "$include_none" -eq 1 ]; then
            tags+=("__none__")
            descs+=("$none_desc")
        fi
        printf '%s%s%s\n' "$C_BOLD" "$prompt" "$C_RESET"
        local i
        for (( i=0; i<${#tags[@]}; i++ )); do
            if [ "${tags[$i]}" = "$default_tag" ]; then
                def_idx=$((i+1))
            fi
            printf '  %2d) %-18s (%s)\n' "$idx" "${tags[$i]}" "${descs[$i]}"
            idx=$((idx+1))
        done
        while :; do
            text_input "Choose partition by number" "$def_idx"
            if [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le "${#tags[@]}" ]; then
                REPLY="${tags[$((REPLY-1))]}"
                return 0
            fi
            warn "Invalid partition selection."
        done
    fi
}

configure_manual_partitions() {
    local dev="$1"
    local launch_cfdisk="y"
    if [ "$UI_MODE" = "tui" ]; then
        tui_yesno "Partition editor (cfdisk)" "Open cfdisk on $dev to create or edit partitions?\n\nChoose Yes to launch cfdisk (recommended if disk is blank),\nor No to assign existing partitions directly." "y"
        launch_cfdisk="$REPLY"
    else
        text_yesno "Open cfdisk on $dev to create or edit partitions?" "y"
        launch_cfdisk="$REPLY"
    fi

    if [ "$launch_cfdisk" = "y" ]; then
        if ! command -v cfdisk >/dev/null 2>&1; then
            die "cfdisk is not installed; cannot run manual partitioning."
        fi
        if [ "$UI_MODE" = "tui" ]; then
            tui_msg "Manual partition (cfdisk)" "cfdisk will open on $dev.\n\nRecommended partitions:\n  - 512 MiB EFI System Partition (type: EFI System)\n  - Root partition (type: Linux filesystem)\n  - Optional swap partition (type: Linux swap)\n\nSelect Write then Quit when finished — you will choose /, /boot/efi, and swap paths next."
        else
            info "Launching cfdisk on $dev. Write then Quit when finished."
        fi
        cfdisk "$dev" || true
        if [ "$UI_MODE" = "tui" ]; then
            tput clear 2>/dev/null || printf '\033[2J\033[H'
        fi
        partprobe "$dev" >/dev/null 2>&1 || true
        sleep 1
        udevadm settle >/dev/null 2>&1 || true
    fi

    local parts=()
    mapfile -t parts < <(lsblk -lnpo NAME,TYPE "$dev" 2>/dev/null | awk '$2 == "part" { print $1 }')
    [ "${#parts[@]}" -ge 1 ] || die "No partitions found on $dev. Create partitions first and re-run."

    # 1) Choose Root (/) partition
    local default_root="" p cur_fs=""
    for p in "${parts[@]}"; do
        cur_fs="$(blkid -s TYPE -o value "$p" 2>/dev/null || true)"
        if [[ "$cur_fs" =~ ^(ext4|ext3|ext2|btrfs|xfs|f2fs|jfs)$ ]]; then
            default_root="$p"
            break
        fi
    done
    pick_partition_menu "Root partition (/)" "Select the partition to mount as root (/):" "$default_root" 0 "" "${parts[@]}"
    ROOT_PART="$REPLY"

    cur_fs="$(blkid -s TYPE -o value "$ROOT_PART" 2>/dev/null || true)"
    if [[ "$cur_fs" =~ ^(ext4|ext3|ext2|btrfs|xfs|f2fs|jfs)$ ]]; then
        choose_root_filesystem 1 "$cur_fs"
    else
        choose_root_filesystem 0 ""
    fi

    # 2) Choose EFI System Partition (/boot/efi)
    local remaining_for_efi=() default_efi="" arch="" allow_no_efi=0
    arch="$(host_arch)"
    if [ "$arch" = "amd64" ] && [ ! -d /sys/firmware/efi ]; then
        allow_no_efi=1
    fi
    for p in "${parts[@]}"; do
        [ "$p" = "$ROOT_PART" ] && continue
        remaining_for_efi+=("$p")
        if [ -z "$default_efi" ]; then
            cur_fs="$(blkid -s TYPE -o value "$p" 2>/dev/null || true)"
            [ "$cur_fs" = "vfat" ] && default_efi="$p"
        fi
    done

    EFI_PART=""
    FORMAT_EFI=0
    if [ "${#remaining_for_efi[@]}" -eq 0 ]; then
        if [ "$allow_no_efi" -eq 0 ]; then
            die "UEFI/ARM64 installation requires a separate EFI System Partition (/boot/efi) in addition to root (/)."
        fi
    else
        while :; do
            pick_partition_menu "EFI partition (/boot/efi)" "Select the EFI System Partition (/boot/efi):" "${default_efi:-${remaining_for_efi[0]}}" "$allow_no_efi" "Skip (legacy BIOS-only, no /boot/efi)" "${remaining_for_efi[@]}"
            if [ "$REPLY" = "__none__" ]; then
                EFI_PART=""
                FORMAT_EFI=0
                break
            fi
            EFI_PART="$REPLY"
            cur_fs="$(blkid -s TYPE -o value "$EFI_PART" 2>/dev/null || true)"
            if [ "$cur_fs" = "vfat" ]; then
                if [ "$UI_MODE" = "tui" ]; then
                    tui_menu "EFI partition format" "$EFI_PART already has a FAT32 (vfat) filesystem.\nFormat it or keep existing EFI boot files (e.g. dual-boot)?" "keep" \
                        "keep"   "Keep existing FAT32 filesystem (recommended for dual-boot)" \
                        "format" "Format $EFI_PART as FAT32"
                else
                    text_choice "$EFI_PART is already vfat:" 1 "keep (Keep existing FAT32)" "format (Format as FAT32)"
                    REPLY="${REPLY%% *}"
                fi
                [ "$REPLY" = "format" ] && FORMAT_EFI=1 || FORMAT_EFI=0
                break
            else
                ui_yesno "Format EFI partition" "$EFI_PART is currently '${cur_fs:-unformatted}'. Format it as FAT32 for /boot/efi?" "y"
                if [ "$REPLY" = "y" ]; then
                    FORMAT_EFI=1
                    break
                fi
            fi
        done
    fi

    # 3) Choose optional Swap partition
    local remaining_for_swap=() default_swap="__none__"
    for p in "${parts[@]}"; do
        [ "$p" = "$ROOT_PART" ] && continue
        [ -n "$EFI_PART" ] && [ "$p" = "$EFI_PART" ] && continue
        remaining_for_swap+=("$p")
        if [ "$default_swap" = "__none__" ]; then
            cur_fs="$(blkid -s TYPE -o value "$p" 2>/dev/null || true)"
            [ "$cur_fs" = "swap" ] && default_swap="$p"
        fi
    done

    SWAP_PART=""
    FORMAT_SWAP=0
    if [ "${#remaining_for_swap[@]}" -gt 0 ]; then
        pick_partition_menu "Swap partition (optional)" "Select an optional swap partition (or None):" "$default_swap" 1 "None (do not use a swap partition)" "${remaining_for_swap[@]}"
        if [ "$REPLY" != "__none__" ]; then
            SWAP_PART="$REPLY"
            cur_fs="$(blkid -s TYPE -o value "$SWAP_PART" 2>/dev/null || true)"
            if [ "$cur_fs" = "swap" ]; then
                FORMAT_SWAP=0
            else
                ui_yesno "Format swap" "$SWAP_PART (${cur_fs:-unformatted}) is not swap yet. Initialize as swap?" "y"
                if [ "$REPLY" = "y" ]; then
                    FORMAT_SWAP=1
                else
                    SWAP_PART=""
                    FORMAT_SWAP=0
                fi
            fi
        fi
    fi
}

format_manual_partitions() {
    [ -b "$ROOT_PART" ] || die "Root partition $ROOT_PART not found."
    if [ "$FORMAT_ROOT" -eq 1 ]; then
        format_root_partition "$ROOT_PART" "$ROOT_FSTYPE"
    fi
    if [ -n "$EFI_PART" ]; then
        [ -b "$EFI_PART" ] || die "EFI partition $EFI_PART not found."
        if [ "$FORMAT_EFI" -eq 1 ]; then
            info "Formatting EFI ($EFI_PART) as FAT32..."
            mkfs.fat -F32 -n EFI "$EFI_PART" >/dev/null
        fi
    fi
    if [ -n "$SWAP_PART" ]; then
        [ -b "$SWAP_PART" ] || die "Swap partition $SWAP_PART not found."
        swapoff "$SWAP_PART" 2>/dev/null || true
        if [ "$FORMAT_SWAP" -eq 1 ]; then
            info "Formatting swap ($SWAP_PART)..."
            mkswap -L swap "$SWAP_PART" >/dev/null
        fi
    fi
}

# -----------------------------------------------------------------------------
# INSTALL (Calmares 'exec' sequence: mount → unpackfs → ... → umount)
# -----------------------------------------------------------------------------
mount_root_target() {
    info "Mounting target root filesystem ($ROOT_PART) at $TARGET_ROOT."
    mkdir -p "$TARGET_ROOT"
    mount "$ROOT_PART" "$TARGET_ROOT"
    MOUNT_POINTS+=("$TARGET_ROOT")
}

mount_target_runtime() {
    info "Mounting target EFI and runtime filesystems under $TARGET_ROOT."
    if [ -n "$EFI_PART" ]; then
        mkdir -p "$TARGET_ROOT/boot/efi"
        mount "$EFI_PART" "$TARGET_ROOT/boot/efi"
        MOUNT_POINTS+=("$TARGET_ROOT/boot/efi")
    fi
    if [ -n "$SWAP_PART" ]; then
        if swapon "$SWAP_PART"; then
            SWAP_ACTIVATED=1
        else
            warn "swapon $SWAP_PART failed — continuing."
        fi
    fi
    # Live-bind the bits Calamares' mount.conf binds (proc/sys/dev/run/...).
    mkdir -p "$TARGET_ROOT/proc" "$TARGET_ROOT/sys" "$TARGET_ROOT/dev" "$TARGET_ROOT/run"
    mount -t proc  proc  "$TARGET_ROOT/proc";  MOUNT_POINTS+=("$TARGET_ROOT/proc")
    mount -t sysfs sysfs "$TARGET_ROOT/sys";   MOUNT_POINTS+=("$TARGET_ROOT/sys")
    if [ -d /sys/firmware/efi/efivars ]; then
        mkdir -p "$TARGET_ROOT/sys/firmware/efi/efivars"
        if mount -t efivarfs efivarfs "$TARGET_ROOT/sys/firmware/efi/efivars" 2>/dev/null; then
            MOUNT_POINTS+=("$TARGET_ROOT/sys/firmware/efi/efivars")
        fi
    fi
    mount --bind /dev "$TARGET_ROOT/dev";      MOUNT_POINTS+=("$TARGET_ROOT/dev")
    mkdir -p "$TARGET_ROOT/dev/pts"
    if ! mountpoint -q "$TARGET_ROOT/dev/pts" 2>/dev/null; then
        if mount -t devpts devpts "$TARGET_ROOT/dev/pts" 2>/dev/null; then
            MOUNT_POINTS+=("$TARGET_ROOT/dev/pts")
        fi
    fi
    mount -t tmpfs tmpfs "$TARGET_ROOT/run";   MOUNT_POINTS+=("$TARGET_ROOT/run")
    if [ -d /run/udev ]; then
        mkdir -p "$TARGET_ROOT/run/udev"
        if mount --bind /run/udev "$TARGET_ROOT/run/udev" 2>/dev/null; then
            MOUNT_POINTS+=("$TARGET_ROOT/run/udev")
        fi
    fi
    if [ -d /run/systemd/resolve ]; then
        mkdir -p "$TARGET_ROOT/run/systemd/resolve"
        if mount --bind /run/systemd/resolve "$TARGET_ROOT/run/systemd/resolve" 2>/dev/null; then
            MOUNT_POINTS+=("$TARGET_ROOT/run/systemd/resolve")
        fi
    fi
}

unpack_target() {
    if [ "$UI_MODE" = "tui" ]; then
        printf '[i] Unpacking live squashfs into %s...\n' "$TARGET_ROOT" >> "$INSTALL_LOG"
    else
        info "Unpacking live squashfs into $TARGET_ROOT (this can take several minutes)..."
    fi
    if command -v unsquashfs >/dev/null 2>&1; then
        if [ "$UI_MODE" = "tui" ]; then
            local expected_bytes=0 base_used=0
            if [ -r "${LIVE_CDROM}/casper/filesystem.size" ]; then
                expected_bytes="$(tr -dc '0-9' < "${LIVE_CDROM}/casper/filesystem.size" || true)"
            fi
            if [ -z "$expected_bytes" ] || [ "$expected_bytes" -le 0 ]; then
                expected_bytes="$(stat -c %s "$LIVE_SQUASHFS" 2>/dev/null || echo 1000000000)"
                expected_bytes=$(( expected_bytes * 3 ))
            fi
            base_used="$(df -B1 --output=used "$TARGET_ROOT" 2>/dev/null | tail -n1 | tr -dc '0-9' || echo 0)"
            [ -n "$base_used" ] || base_used=0
            unsquashfs -no-progress -d "$TARGET_ROOT" -f "$LIVE_SQUASHFS" >> "$INSTALL_LOG" 2>&1 &
            local unsq_pid=$!
            while kill -0 "$unsq_pid" 2>/dev/null; do
                local cur_used=0 delta=0 pct=20
                cur_used="$(df -B1 --output=used "$TARGET_ROOT" 2>/dev/null | tail -n1 | tr -dc '0-9' || echo 0)"
                if [[ "$cur_used" =~ ^[0-9]+$ ]] && [ "$cur_used" -ge "$base_used" ]; then
                    delta=$(( cur_used - base_used ))
                    pct=$(( 18 + (delta * 37) / expected_bytes ))
                    [ "$pct" -gt 55 ] && pct=55
                    [ "$pct" -lt 18 ] && pct=18
                fi
                progress_update "$pct" "Copying system files to disk..."
                sleep 1
            done
            wait "$unsq_pid"
        else
            unsquashfs -d "$TARGET_ROOT" -f "$LIVE_SQUASHFS"
        fi
    else
        # Fallback: mount the squashfs and rsync.
        local tmp_mnt
        tmp_mnt="$(mktemp -d)"
        {
            mount -t squashfs -o loop "$LIVE_SQUASHFS" "$tmp_mnt"
            rsync -aHAX --numeric-ids "$tmp_mnt"/ "$TARGET_ROOT"/
            umount "$tmp_mnt"
        } >> "$INSTALL_LOG" 2>&1
        rmdir "$tmp_mnt"
    fi
    if [ "$UI_MODE" = "tui" ]; then
        printf '[+] Live filesystem unpacked.\n' >> "$INSTALL_LOG"
    else
        ok "Live filesystem unpacked."
    fi
}

# Workaround for LP#1829805 (initramfs skipped on first run if /boot/initrd.img-*
# is missing in the target). Runs inside the chroot.
chroot_initramfs_touch() {
    info "Workaround for LP#1829805: touching /boot/initrd.img-* for installed kernels."
    chroot "$TARGET_ROOT" /bin/bash <<'CHROOT_EOF'
for k in /boot/vmlinuz-*; do
    [ -e "$k" ] || continue
    touch "/boot/initrd.img-${k##*/vmlinuz-}"
done
CHROOT_EOF
}

run_in_chroot() {
    chroot "$TARGET_ROOT" /bin/bash -c "$1"
}

# Equivalent of calamares 'machineid' (with dbus symlink).
configure_machineid() {
    info "Generating /etc/machine-id in target."
    systemd-machine-id-setup --root="$TARGET_ROOT" >/dev/null 2>&1 \
        || chroot "$TARGET_ROOT" /bin/bash -c "systemd-machine-id-setup"
    run_in_chroot "dbus-uuidgen --ensure=/etc/machine-id"
}

# Equivalent of calamares 'fstab' — UUID-based.
configure_fstab() {
    info "Writing /etc/fstab (UUID-based)."
    local fstab="$TARGET_ROOT/etc/fstab"
    {
        printf '# /etc/fstab — generated by %s-cli-installer\n' "$DISTRO_ID"
        printf '# <device>\t<dir>\t<type>\t<options>\t<dump>\t<pass>\n'
        if [ -n "$EFI_PART" ]; then
            local efi_uuid
            efi_uuid="$(blkid -s UUID -o value "$EFI_PART")"
            printf 'UUID=%s\t/boot/efi\tvfat\tumask=0077\t0\t2\n' "$efi_uuid"
        fi
        if [ -n "$ROOT_PART" ]; then
            local root_uuid
            root_uuid="$(blkid -s UUID -o value "$ROOT_PART")"
            printf 'UUID=%s\t/\t%s\tdefaults\t0\t1\n' "$root_uuid" "$(blkid -s TYPE -o value "$ROOT_PART")"
        fi
        if [ -n "$SWAP_PART" ]; then
            local swap_uuid
            swap_uuid="$(blkid -s UUID -o value "$SWAP_PART")"
            printf 'UUID=%s\tnone\tswap\tsw\t0\t0\n' "$swap_uuid"
        fi
    } > "$fstab"
}

configure_locale() {
    info "Generating locale $LOCALE and configuring timezone $TIMEZONE in the target."
    # Mirrors calamares/localecfg + locale.conf.
    if [ -f "$TARGET_ROOT/etc/locale.gen" ]; then
        sed -i "s/^# *${LOCALE} UTF-8/${LOCALE} UTF-8/" "$TARGET_ROOT/etc/locale.gen"
    fi
    if [ ! -f "$TARGET_ROOT/etc/locale.gen" ] || ! grep -qxF "${LOCALE} UTF-8" "$TARGET_ROOT/etc/locale.gen"; then
        echo "${LOCALE} UTF-8" >> "$TARGET_ROOT/etc/locale.gen"
    fi
    run_in_chroot "locale-gen $LOCALE"
    run_in_chroot "update-locale LANG=$LOCALE"
    echo "LANG=$LOCALE" > "$TARGET_ROOT/etc/default/locale"
    # Timezone (hwclock in calamares is set later, but storing here is safe).
    echo "$TIMEZONE" > "$TARGET_ROOT/etc/timezone"
    run_in_chroot "ln -sf /usr/share/zoneinfo/$TIMEZONE /etc/localtime"
    run_in_chroot "dpkg-reconfigure -f noninteractive tzdata"
}

configure_keyboard() {
    info "Configuring keyboard layout in target ($KEYBOARD_LAYOUT)."
    cat > "$TARGET_ROOT/etc/default/keyboard" <<EOF
# Generated by ${DISTRO_ID}-cli-installer
XKBLAYOUT="$KEYBOARD_LAYOUT"
XKBVARIANT="$KEYBOARD_VARIANT"
XKBOPTIONS=""
BACKSPACE="guess"
EOF
    run_in_chroot "dpkg-reconfigure -f noninteractive keyboard-configuration || true"
    run_in_chroot "setupcon -k 2>/dev/null || true"
}

# Equivalent of calamares 'users' module (doAutologin=false, setRootPassword=false,
# sudoersGroup=sudo, defaultGroups=adm,cdrom,dip,lpadmin,plugdev,sudo,
# passwordRequirements: minLength 8, user.shell=/bin/bash, forbidden=root).
create_user() {
    info "Creating user $USERNAME with home directory, default groups, and sudoers."
    chroot "$TARGET_ROOT" useradd -m -s /bin/bash -c "$FULLNAME" "$USERNAME"
    printf '%s:%s\n' "$USERNAME" "$PASSWORD" | chroot "$TARGET_ROOT" chpasswd
    for g in adm cdrom dip lpadmin plugdev sudo; do
        chroot "$TARGET_ROOT" usermod -aG "$g" "$USERNAME" 2>/dev/null || true
    done
    # Set chosen hostname in target /etc/hostname and /etc/hosts.
    echo "$HOSTNAME" > "$TARGET_ROOT/etc/hostname"
    cat > "$TARGET_ROOT/etc/hosts" <<EOF
127.0.0.1 localhost
127.0.1.1 ${HOSTNAME}

::1 ip6-localhost ip6-loopback
fe00::0 ip6-localnet
ff00::0 ip6-mcastprefix
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters
EOF
}

# Equivalent of calamares 'displaymanager' (autodetect gdm3/lightdm/sddm/cosmic-greeter).
configure_displaymanager() {
    info "Configuring display manager (autodetect)."
    chroot "$TARGET_ROOT" /bin/bash <<'CHROOT_EOF'
set -e
for dm in cosmic-greeter gdm3 lightdm sddm; do
    if dpkg -s "$dm" >/dev/null 2>&1; then
        echo "Found DM: $dm — enabling."
        if [ "$dm" = "cosmic-greeter" ]; then
            mkdir -p /etc/X11 /etc/systemd/system
            echo "/usr/bin/cosmic-greeter" > /etc/X11/default-display-manager
            if [ -e /lib/systemd/system/cosmic-greeter.service ]; then
                ln -sf /lib/systemd/system/cosmic-greeter.service /etc/systemd/system/display-manager.service
            elif [ -e /usr/lib/systemd/system/cosmic-greeter.service ]; then
                ln -sf /usr/lib/systemd/system/cosmic-greeter.service /etc/systemd/system/display-manager.service
            fi
            systemctl --root=/ disable greetd.service >/dev/null 2>&1 || true
            systemctl --root=/ enable cosmic-greeter-daemon.service >/dev/null 2>&1 || true
        else
            systemctl --root=/ enable "$dm" >/dev/null 2>&1 || true
        fi
        systemctl --root=/ set-default graphical.target >/dev/null 2>&1 || true
        break
    fi
done
CHROOT_EOF
}

# Equivalent of calamares 'networkcfg' (debian: write /etc/network/interfaces for
# loopback only — most desktop installs use NetworkManager from the chosen DE).
configure_network() {
    info "Configuring target network netplan defaults."
    mkdir -p "$TARGET_ROOT/etc/netplan"
    if chroot "$TARGET_ROOT" dpkg -s network-manager >/dev/null 2>&1; then
        cat > "$TARGET_ROOT/etc/netplan/01-network-manager-all.yaml" <<'EOF'
network:
  version: 2
  renderer: NetworkManager
EOF
        chmod 0600 "$TARGET_ROOT/etc/netplan/01-network-manager-all.yaml"
    else
        cat > "$TARGET_ROOT/etc/netplan/01-dhcp-all.yaml" <<'EOF'
network:
  version: 2
  ethernets:
    all-ethernet:
      match:
        name: "en*"
      dhcp4: true
      dhcp6: true
EOF
        chmod 0600 "$TARGET_ROOT/etc/netplan/01-dhcp-all.yaml"
        chroot "$TARGET_ROOT" systemctl enable systemd-networkd.service >/dev/null 2>&1 || true
    fi
}

# Equivalent of calamares 'hwclock' (set UTC hardware clock).
configure_hwclock() {
    info "Setting hardware clock to UTC."
    run_in_chroot "hwclock --systohc --utc" || warn "hwclock failed — continuing."
}

# Equivalent of calamares 'initramfscfg' + 'initramfs'.
configure_initramfs() {
    info "Regenerating initramfs for all installed kernels."
    chroot "$TARGET_ROOT" /bin/bash <<'CHROOT_EOF'
set -e
if command -v update-initramfs >/dev/null 2>&1; then
    for img in /boot/vmlinuz-*; do
        [ -e "$img" ] || continue
        ver="${img##*/vmlinuz-}"
        update-initramfs -u -t -k "$ver"
    done
elif command -v dracut >/dev/null 2>&1; then
    dracut --regenerate-all --force
fi
CHROOT_EOF
}

# Equivalent of calamares 'grubcfg' (defaults + GRUB_ENABLE_CRYPTODISK=true).
configure_grubcfg() {
    info "Writing /etc/default/grub (GRUB_ENABLE_CRYPTODISK=true)."
    if [ "$DISTRO_ID" = "pop" ]; then
        if [ -f "$TARGET_ROOT/usr/share/grub/themes/pop/theme.txt" ] && [ ! -f "$TARGET_ROOT/boot/grub/themes/pop/theme.txt" ]; then
            mkdir -p "$TARGET_ROOT/boot/grub/themes"
            cp -a "$TARGET_ROOT/usr/share/grub/themes/pop" "$TARGET_ROOT/boot/grub/themes/pop"
        fi
    fi
    {
        printf '# Generated by %s-cli-installer.\n' "$DISTRO_ID"
        cat <<'EOF'
GRUB_DEFAULT=0
GRUB_TIMEOUT_STYLE=menu
GRUB_TIMEOUT=10
EOF
        if [ "$DISTRO_ID" = "pop" ]; then
            printf 'GRUB_DISTRIBUTOR="Pop!_OS"\n'
            if [ -f "$TARGET_ROOT/boot/grub/themes/pop/theme.txt" ]; then
                printf 'GRUB_THEME="/boot/grub/themes/pop/theme.txt"\n'
            elif [ -f "$TARGET_ROOT/usr/share/grub/themes/pop/theme.txt" ]; then
                printf 'GRUB_THEME="/usr/share/grub/themes/pop/theme.txt"\n'
            fi
        else
            cat <<'EOF'
GRUB_DISTRIBUTOR=`lsb_release -i -s 2>/dev/null || ( . /etc/os-release 2>/dev/null && echo "${NAME:-Ubuntu}" ) || echo Ubuntu`
EOF
        fi
        cat <<'EOF'
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_CMDLINE_LINUX=""
GRUB_ENABLE_CRYPTODISK=true
EOF
    } > "$TARGET_ROOT/etc/default/grub"
}

# Equivalent of calamares 'bootloader' (UEFI + legacy BIOS on amd64; UEFI-only on arm64).
install_bootloader() {
    local arch boot_id efi_target
    arch="$(target_arch)"
    boot_id="$(target_bootloader_id)"
    efi_target="x86_64-efi"
    [ "$arch" = "arm64" ] && efi_target="arm64-efi"

    info "Installing GRUB to $DISK_TARGET (arch=$arch, bootloader-id=$boot_id)."

    if [ -n "$EFI_PART" ] && { [ -d /sys/firmware/efi ] || [ "$arch" = "arm64" ]; }; then
        chroot "$TARGET_ROOT" /bin/bash -c "
            set -e
            grub-install --target=${efi_target} --efi-directory=/boot/efi --bootloader-id=${boot_id} --recheck
            grub-install --target=${efi_target} --efi-directory=/boot/efi --bootloader-id=${boot_id} --removable --recheck
        "
    elif [ -n "$EFI_PART" ] && [ "$arch" = "amd64" ]; then
        chroot "$TARGET_ROOT" grub-install --target="${efi_target}" --efi-directory=/boot/efi --bootloader-id="${boot_id}" --no-nvram --removable --recheck 2>/dev/null || true
    fi

    if [ "$arch" = "amd64" ]; then
        if [ -d /sys/firmware/efi ]; then
            chroot "$TARGET_ROOT" grub-install --target=i386-pc "$DISK_TARGET" 2>/dev/null || true
        else
            chroot "$TARGET_ROOT" grub-install --target=i386-pc "$DISK_TARGET"
        fi
    fi

    run_in_chroot "grub-mkconfig -o /boot/grub/grub.cfg"
}

# Equivalent of calamares 'packages' (strip live-only packages and installer files;
# try_install language packs for the chosen locale).
strip_live_packages() {
    info "Removing live-only packages and installer files from the target."
    chroot "$TARGET_ROOT" /bin/bash <<'CHROOT_EOF'
set -e
export DEBIAN_FRONTEND=noninteractive
to_purge=()
for p in calamares casper cifs-utils discover laptop-detect os-prober; do
    if dpkg -s "$p" >/dev/null 2>&1; then
        to_purge+=("$p")
    fi
done
if [ "${#to_purge[@]}" -gt 0 ]; then
    apt-get -y purge "${to_purge[@]}" || true
fi
apt-get -y autoremove --purge || true
CHROOT_EOF
    rm -f "$TARGET_ROOT/usr/local/bin/install-system" \
          "$TARGET_ROOT/etc/profile.d/99-uvb-live-cli.sh" \
          "$TARGET_ROOT/etc/casper.conf" \
          "$TARGET_ROOT/etc/ssh/sshd_config.d/01-uvb-live-ssh.conf" \
          "$TARGET_ROOT/usr/local/sbin/uvb-live-ssh-setup" \
          "$TARGET_ROOT/etc/systemd/system/uvb-live-ssh-user.service" \
          "$TARGET_ROOT/etc/systemd/system/multi-user.target.wants/uvb-live-ssh-user.service" \
          "$TARGET_ROOT/usr/local/sbin/uvb-live-cosmic-autologin" \
          "$TARGET_ROOT/etc/systemd/system/uvb-live-cosmic-autologin.service" \
          "$TARGET_ROOT/etc/systemd/system/multi-user.target.wants/uvb-live-cosmic-autologin.service" \
          "$TARGET_ROOT/usr/share/applications/install-system.desktop" \
          "$TARGET_ROOT/etc/skel/Desktop/install-system.desktop"
    rm -rf "$TARGET_ROOT/etc/calamares"
    info "Installing language packs for $LOCALE (best-effort, online only)."
    local short="${LOCALE%.*}"           # en_US.UTF-8 -> en_US
    local lang="${short%_*}"             # en_US -> en
    local hunspell_tag="${short,,}"
    hunspell_tag="${hunspell_tag//_/-}"  # en_US -> en-us
    chroot "$TARGET_ROOT" /bin/bash -c "
        set -e
        export DEBIAN_FRONTEND=noninteractive
        for pkg in language-pack-${lang} hunspell-${hunspell_tag} libreoffice-help-${lang} libreoffice-l10n-${lang}; do
            apt-get install -y --no-install-recommends -o Acquire::http::Timeout=5 -o Acquire::Retries=0 \"\$pkg\" 2>/dev/null || true
        done
    " || true
}

umount_target() {
    info "Unmounting target filesystems."
    # Order matters: deepest first.
    if [ "${SWAP_ACTIVATED:-0}" -eq 1 ] && [ -n "${SWAP_PART:-}" ]; then
        swapoff "$SWAP_PART" 2>/dev/null || true
    fi
    SWAP_ACTIVATED=0
    local idx mp=""
    for (( idx=${#MOUNT_POINTS[@]}-1 ; idx>=0 ; idx-- )); do
        mp="${MOUNT_POINTS[$idx]}"
        [ -n "$mp" ] || continue
        if mountpoint -q "$mp" 2>/dev/null; then
            umount "$mp" 2>/dev/null || umount -l "$mp" 2>/dev/null || warn "Could not unmount $mp."
        fi
    done
    MOUNT_POINTS=()
    [ -d "$TARGET_ROOT" ] && rmdir "$TARGET_ROOT" 2>/dev/null || true
}

run_step_logged() {
    local pct="$1" msg="$2"
    shift 2
    CURRENT_INSTALL_STEP="$msg"
    progress_update "$pct" "$msg"
    if [ "$UI_MODE" = "tui" ]; then
        "$@" >> "$INSTALL_LOG" 2>&1
    else
        "$@" 2>&1 | tee -a "$INSTALL_LOG"
    fi
}

run_installation() {
    STEP_LABEL="Installing ${DISTRO_NAME}"
    CURRENT_INSTALL_STEP="Preparing installation"
    if ! (: > "$INSTALL_LOG") 2>/dev/null; then
        INSTALL_LOG="$(mktemp /tmp/install-system-log.XXXXXX)"
    fi

    if [ "$UI_MODE" = "tui" ]; then
        open_gauge "Installing ${DISTRO_NAME}" "Preparing installation..."
    else
        step "Installing ${DISTRO_NAME}"
        hr
    fi

    trap 'die "Installation failed during: ${CURRENT_INSTALL_STEP:-unknown}"' ERR

    if [ "$DISK_MODE" = "erase" ]; then
        run_step_logged 5 "Partitioning and formatting ${DISK_TARGET}..." partition_erase "$DISK_TARGET"
    else
        run_step_logged 5 "Preparing selected partitions on ${DISK_TARGET}..." format_manual_partitions
    fi

    run_step_logged 12 "Mounting target root filesystem (${ROOT_PART})..." mount_root_target

    CURRENT_INSTALL_STEP="Copying system files to disk"
    progress_update 18 "Copying system files to disk..."
    if [ "$UI_MODE" = "tui" ]; then
        unpack_target
    else
        unpack_target 2>&1 | tee -a "$INSTALL_LOG"
    fi

    run_step_logged 58 "Mounting EFI and virtual filesystems..." mount_target_runtime
    run_step_logged 62 "Generating machine ID and /etc/fstab..." configure_machineid
    run_step_logged 65 "Writing /etc/fstab..." configure_fstab
    run_step_logged 68 "Configuring locale (${LOCALE}) and timezone (${TIMEZONE})..." configure_locale
    run_step_logged 73 "Configuring keyboard layout (${KEYBOARD_LAYOUT})..." configure_keyboard
    run_step_logged 76 "Preparing kernel initramfs hooks..." chroot_initramfs_touch
    run_step_logged 79 "Creating user account (${USERNAME})..." create_user
    run_step_logged 82 "Configuring display manager and network..." configure_displaymanager
    run_step_logged 85 "Writing target network configuration..." configure_network
    run_step_logged 87 "Synchronizing hardware clock..." configure_hwclock
    run_step_logged 90 "Generating initramfs images..." configure_initramfs
    run_step_logged 93 "Configuring and installing GRUB bootloader..." configure_grubcfg
    run_step_logged 95 "Installing GRUB bootloader to ${DISK_TARGET}..." install_bootloader
    run_step_logged 98 "Removing live-only packages and installer files..." strip_live_packages
    run_step_logged 99 "Unmounting target filesystems..." umount_target
    sync

    trap - ERR
    progress_update 100 "Installation complete!"
    if [ "$UI_MODE" = "tui" ]; then
        sleep 0.6
        close_gauge
    else
        ok "Installation complete."
    fi
}

# -----------------------------------------------------------------------------
# STEP: finished
# -----------------------------------------------------------------------------
step_finished() {
    STEP_LABEL="Installation Complete"
    if [ "$UI_MODE" != "tui" ]; then
        step "Installation Complete"
    fi

    local action="restart"
    if [ "$UI_MODE" = "tui" ]; then
        tui_menu "Installation Complete" \
            "${DISTRO_NAME} has been installed on ${DISK_TARGET}.\n\nYou can continue testing the live environment, or restart now to boot into your new ${DISTRO_NAME} system." \
            "restart" \
            "restart"  "Restart Now (recommended)" \
            "continue" "Continue Testing / Exploring Live System"
        action="$REPLY"
    else
        banner "Installation complete!"
        info "${DISTRO_NAME} has been installed on ${DISK_TARGET}."
        text_choice "What would you like to do next?" 1 \
            "Restart Now" \
            "Continue Testing / Exploring Live System"
        case "$REPLY" in
            Restart*) action="restart" ;;
            *)        action="continue" ;;
        esac
    fi

    if [ "$action" = "restart" ]; then
        if [ "$UI_MODE" = "tui" ]; then
            tput clear 2>/dev/null || printf '\033[2J\033[H'
        fi
        info "Rebooting into the new ${DISTRO_NAME} system..."
        sleep 1
        systemctl -i reboot || reboot
    else
        if [ "$UI_MODE" = "tui" ]; then
            tput clear 2>/dev/null || printf '\033[2J\033[H'
        fi
        ok "Continuing in live mode. Target filesystems are unmounted; run 'sudo reboot' when ready."
    fi
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------
main() {
