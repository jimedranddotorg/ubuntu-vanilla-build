#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# install-system — Unofficial CLI Installer (TUI/CLI) for Ubuntu & Pop!_OS
# live ISOs (installed at /usr/local/bin/install-system). Mirrors the
# Calamares module sequence in scripts/calamares/settings.conf:
#
#   welcome → locale → keyboard → timezone → disk/partitions → users → summary
#     → partition → mount → unpackfs → machineid → fstab → locale
#     → keyboard → localecfg → users → displaymanager → networkcfg
#     → hwclock → initramfscfg → initramfs → grubcfg → bootloader
#     → packages/cleanup → umount → finished (Restart Now / Continue Testing)
#
# Usage (interactive, on the live ISO):
#   sudo install-system
#
# The script assumes it is running from the live ISO (casper). It verifies
# both a live session (/proc/cmdline boot=casper or overlay root) and the
# squashfs at /cdrom/casper/filesystem.squashfs before modifying anything.

