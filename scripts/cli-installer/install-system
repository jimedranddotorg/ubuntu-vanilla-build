read_i18n_entries() {
    # Echo "<locale>\t<pretty>" lines from the embedded SUPPORTED_LOCALES.
    local tag
    while read -r tag _; do
        [ -n "$tag" ] || continue
        printf '%s\t%s\n' "$tag" "$(describe_locale_code "$tag")"
    done < <(awk 'NF>=2 && $2 ~ /UTF-8/ { print $1, $2 }' <<<"$SUPPORTED_LOCALES")
}

step_locale() {
    step_begin 2 7 "Language & Locale" "Default is en_US.UTF-8. Type a number, code/filter, or press Enter."

    local map_file
    map_file="$(mktemp)"
    read_i18n_entries > "$map_file"

    local default_locale="en_US.UTF-8"

    if [ "$UI_MODE" = "tui" ]; then
        local filter="" filtered=""
        while :; do
            if [ -z "$filter" ]; then
                filtered="$(cat "$map_file")"
            else
                filtered="$(grep -Fi -- "$filter" "$map_file" || true)"
            fi
            if [ -z "$filtered" ]; then
                ui_warn "No Match" "No locales matched '${filter}'. Showing all locales."
                filter=""
                filtered="$(cat "$map_file")"
            fi
            local args=() def_item="$default_locale" first_tag=""
            if [ -n "$filter" ]; then
                args+=("__all__" "Show all locales (clear filter: ${filter})")
            else
                args+=("__filter__" "Search / filter locales by code or language")
            fi
            local tag pretty
            while IFS=$'\t' read -r tag pretty; do
                [ -z "$tag" ] && continue
                [ -z "$first_tag" ] && first_tag="$tag"
                args+=("$tag" "$pretty")
            done <<< "$filtered"
            if ! printf '%s\n' "$filtered" | grep -q "^${default_locale}	"; then
                def_item="$first_tag"
            fi
            tui_menu "Language & Locale" "Select your system language and locale:" "$def_item" "${args[@]}"
            if [ "$REPLY" = "__filter__" ]; then
                tui_input "Filter Locales" "Enter language or country code (e.g. en_US, id_ID, German):" ""
                filter="$REPLY"
                continue
            elif [ "$REPLY" = "__all__" ]; then
                filter=""
                continue
            else
                LANG_CHOICE="$REPLY"
                break
            fi
        done
    else
        local filter="" filtered=""
        while :; do
            if [ -z "$filter" ]; then
                filtered="$(cat "$map_file")"
            else
                filtered="$(grep -Fi -- "$filter" "$map_file" || true)"
            fi
            if [ -z "$filtered" ]; then
                warn "No locales matched '$filter' — showing all."
                filter=""
                continue
            fi

            local lines=() cols_labels=() tag pretty def_idx=1 idx=1
            while IFS=$'\t' read -r tag pretty; do
                [ -z "$tag" ] && continue
                lines+=("$tag")
                cols_labels+=("$tag")
                [ "$tag" = "$default_locale" ] && def_idx="$idx"
                idx=$((idx + 1))
            done <<< "$filtered"

            printf '\n'
            print_columns "$def_idx" 22 "${cols_labels[@]}"
            printf '\n'
            if [ -n "$filter" ]; then
                text_input "Choose number, new filter, 'all' to reset, or locale" "$def_idx"
            else
                text_input "Choose number, locale name, or type text to filter" "$def_idx"
            fi
            if [ "$REPLY" = "all" ] && [ -n "$filter" ]; then
                filter=""
                continue
            elif [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le "${#lines[@]}" ]; then
                LANG_CHOICE="${lines[$((REPLY-1))]}"
                break
            elif grep -qxF "${REPLY}" <(printf '%s\n' "${lines[@]}"); then
                LANG_CHOICE="$REPLY"
                break
            else
                filter="$REPLY"
            fi
        done
    fi
    rm -f "$map_file"

    LOCALE="$LANG_CHOICE"
    COUNTRY="${LOCALE#*_}"
    COUNTRY="${COUNTRY%.*}"
    step_done "Locale: $LOCALE"
}

