# Example build configuration (Advanced Mode)
#
# Config files are loaded only in Advanced Mode (--advanced or ADVANCED_MODE=1).
# Copy this file to build.cfg (or build-popos.cfg, build-img.cfg, etc.) in
# scripts/, or pass --advanced --config=/path/to/file.cfg.
# You can also generate a file interactively with --generate-config.
#
# Precedence: CLI flags > config file > environment > prompts > defaults.

# --- Core ---
# TARGET_UBUNTU_VERSION=noble          # noble | resolute | devel (Ubuntu only; Pop!_OS: noble | resolute)
# TARGET_ARCH=amd64                    # amd64 | arm64
# TARGET_IMAGE_PROFILE=desktop         # desktop | cli
# TARGET_UBUNTU_MIRROR=                # Optional override (defaults to archive/ports/pop-os by distro & arch)
# TARGET_KERNEL_FLAVOR=generic         # Ubuntu: generic | lowlatency ; Pop!_OS: system76 | generic | lowlatency
# TARGET_KERNEL_PACKAGE=               # Optional explicit kernel metapackage override
# TARGET_DESKTOP=gnome                 # cli | cosmic (Pop!_OS only) | gnome | xfce | lxde | lxqt | mate | cinnamon | budgie | kde-plasma
# TARGET_NETWORK_STACK=network-manager # networkd | network-manager (CLI profile; desktop always uses NetworkManager)

# --- Desktop Options ---
# TARGET_GNOME_INSTALL_RECOMMENDS=0    # 0 | 1
# TARGET_KDE_PACKAGE=kde-standard      # kde-full | kde-standard | kde-plasma-desktop
# TARGET_MATE_PACKAGE=mate-desktop-environment  # mate-desktop-environment | mate-desktop-environment-core
# TARGET_MATE_EXTRAS=0                 # 0 | 1

# --- Browsers (Desktop profile only) ---
# TARGET_BRAVE_CHANNEL=release         # none | release | origin
# TARGET_LIBREWOLF=0                   # 0 | 1
# TARGET_FIREFOX=0                     # 0 | 1
# TARGET_FIREFOX_ESR=0                 # 0 | 1
# TARGET_FIREFOX_POPOS=0               # 0 | 1 (Pop!_OS builders only)
# TARGET_THUNDERBIRD=0                 # 0 | 1

# --- Package Manager & Extras ---
# TARGET_PACSTALL=1                    # 0 | 1 (installed via Chaotic PPR repo)
# TARGET_UBUNTU_STUDIO=0               # 0 | 1 (desktop only)
# TARGET_SYSTEM76_DRIVER=0             # 0 | 1 (Pop!_OS builders only)
# TARGET_FWUPD=0                       # 0 | 1
# TARGET_OPENSSH_SERVER=0              # 0 | 1 (defaults to 1 on cloud images)
# TARGET_COCKPIT=0                     # 0 | 1

# --- Disk Image Options (build-img / build-vm / build-removable & Pop!_OS equivalents) ---
# TARGET_FIRMWARE=uefi                 # uefi | hybrid (arm64 is uefi-only; removable defaults to hybrid on amd64)
# TARGET_DISK_SIZE_GB=32               # default 32 (min 10) for cloud/vm; default 16 (min 8) for removable
# TARGET_IMG_ALLOC=truncate            # truncate | fallocate | dd
# TARGET_USER_MODE=deploy              # build | deploy
# TARGET_USERNAME=                     # Required when TARGET_USER_MODE=build (non-interactive)
# TARGET_USER_PASSWORD=                # Required when TARGET_USER_MODE=build (non-interactive)
# TARGET_USER_FULLNAME=                # Optional GECOS
# TARGET_HOSTNAME=                     # Optional hostname
# TARGET_VM_FORMATS=qcow2              # qcow2,vdi,vmdk,vhdx | all | none (VM builders only)

# --- ISO Options (build.sh / build-popos.sh) ---
# TARGET_INSTALLER=calamares           # calamares (desktop, except cosmic) or cli (cli profile / cosmic)
# GRUB_LIVEBOOT_LABEL=Try Ubuntu without installing

# --- Locale & Keyboard (Unattended) ---
# TARGET_LOCALE=en_US.UTF-8
# TARGET_KEYBOARD_LAYOUT=us
# TARGET_KEYBOARD_VARIANT=

# --- Output, UI & Advanced Behavior ---
# TARGET_NAME=                         # Custom filename base (auto-generated with UTC timestamp if empty)
# UBUNTU_VANILLA_WORKSPACE=            # Custom workspace parent directory
# UVB_OUTPUT_DIR=                      # Output directory (default: ~)
# UVB_UI_MODE=cli                      # cli | tui
# ADVANCED_MODE=1                      # 0 | 1
# HOOKS_DIR=                           # Custom hooks directory (default: scripts/hooks/)
# INTERACTIVE=0                        # 0 | 1
# NO_CONFIRM=1                         # 0 | 1
